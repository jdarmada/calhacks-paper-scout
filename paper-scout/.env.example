# Elastic Cloud Serverless > your project > "Connection details"
ELASTICSEARCH_URL=https://my-project.es.us-east-1.aws.elastic.cloud
# KIBANA_URL is optional: it defaults to ELASTICSEARCH_URL with .es. -> .kb.
# KIBANA_URL=https://my-project.kb.us-east-1.aws.elastic.cloud
ELASTIC_API_KEY=paste-your-api-key

# Optional overrides
# PAPERS_INDEX=papers
# EMBEDDING_INFERENCE_ID=.jina-embeddings-v5-text-small
# RERANK_INFERENCE_ID=          # auto-detected (prefers a Jina reranker)
# AGENT_ID=paper-scout
